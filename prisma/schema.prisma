generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PARTICIPANT
  CREATOR
  BOTH
}

model User {
  id       String   @id @default(uuid())
  username String   @default("existing_user")
  email    String   @unique
  password String
  role     UserRole

  nicHash      String? @unique
  nicImagePath String?
  selfiePath   String?

  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
