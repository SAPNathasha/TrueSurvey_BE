generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PARTICIPANT
  CREATOR
  BOTH
}

enum SurveyStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum SurveyAudienceType {
  GENERAL
  CUSTOMERS
  VISITORS
  EMPLOYEES
  VERIFIED_USERS_ONLY
}

enum NotificationType {
  RESPONSE
  SURVEY
  REPORT
  SYSTEM
}

enum SurveyCategory {
  CUSTOMER_FEEDBACK
  MARKET_RESEARCH
  EMPLOYEE_ENGAGEMENT
  EDUCATION
  HEALTHCARE
  PRODUCT_RESEARCH
  EVENT_FEEDBACK
  OTHER
}

enum SurveyCreationStep {
  BASIC_DETAILS
  SELECT_METHOD
  CREATE_QUESTIONS
  TARGET_AUDIENCE
  SAMPLE_BUDGET
  PREVIEW_SUBMIT
  COMPLETED
}

enum SurveyCreationMethod {
  AI_ASSISTED
  MANUAL
}

enum SurveyQuestionType {
  MULTIPLE_CHOICE
  SINGLE_SELECT
  RATING_SCALE
  SHORT_ANSWER
  LONG_ANSWER
  YES_NO
}

enum SurveyQuestionSource {
  AI_GENERATED
  MANUAL
}

enum AiAnswerStyle {
  MULTIPLE_CHOICE
  SINGLE_SELECT
  RATING_SCALE
  MIXED
}

enum AiToneStyle {
  PROFESSIONAL_FRIENDLY
  SIMPLE_CLEAR
  ACADEMIC
  CASUAL
}

enum AudienceGender {
  ALL
  MALE
  FEMALE
  OTHER
}

enum SurveyBudgetCurrency {
  LKR
  USD
}

enum RewardDistributionType {
  EQUAL_PER_PARTICIPANT
}

enum SurveyPublishOption {
  PUBLISH_NOW
  SCHEDULE
  SAVE_DRAFT
}

enum SurveyResponseStatus {
  STARTED
  COMPLETED
  REJECTED
}

enum RewardStatus {
  PENDING
  RELEASED
  REJECTED
  WITHDRAWN
}

enum WalletTransactionType {
  SURVEY_REWARD
  WITHDRAWAL
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id       String   @id @default(uuid())
  username String   @default("existing_user")
  email    String   @unique
  password String
  role     UserRole

  fullName String?

  phoneCountryCode String?
  phoneNumber      String?
  dateOfBirth      DateTime?

  nicHash      String? @unique
  nicImagePath String?
  selfiePath   String?
  isIdentityVerified Boolean @default(false)

  profileImagePath String?
  isEmailVerified  Boolean @default(false)

  refreshTokens RefreshToken[]

  passwordResetTokens PasswordResetToken[]

  createdSurveys Survey[]

  surveyResponses SurveyResponse[]

  notifications Notification[]

  participantAge            Int?
  participantGender         AudienceGender?
  participantCity           String?
  participantDistrict       String?
  participantEducationLevel String?
  participantOccupation     String?
  participantAddress        String?

  wallet             ParticipantWallet?
  walletTransactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Survey {
  id          String @id @default(uuid())
  title       String
  description String

  category SurveyCategory
  audience SurveyAudienceType @default(GENERAL)

  status SurveyStatus @default(DRAFT)

  estimatedCompletionDays Int

  currentStep SurveyCreationStep @default(BASIC_DETAILS)

  creationMethod SurveyCreationMethod?

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  questions SurveyQuestion[]
  responses SurveyResponse[]

  targetAudience SurveyTargetAudience?
  sampleBudget   SurveySampleBudget?

  publishedAt        DateTime?
  scheduledPublishAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([status])
  @@index([category])
}

model Notification {
  id      String           @id @default(uuid())
  title   String
  message String?
  type    NotificationType @default(SYSTEM)
  isRead  Boolean          @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model SurveyQuestion {
  id String @id @default(uuid())

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  questionText String
  type         SurveyQuestionType
  source       SurveyQuestionSource @default(MANUAL)

  order Int

  isRequired Boolean @default(true)

  options SurveyQuestionOption[]
  responseAnswers SurveyResponseAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([surveyId])
  @@index([type])
}

model SurveyQuestionOption {
  id String @id @default(uuid())

  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  optionText String
  order      Int

  createdAt DateTime @default(now())

  @@index([questionId])
}

model SurveyTargetAudience {
  id String @id @default(uuid())

  surveyId String @unique
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  minimumAge Int?
  maximumAge Int?

  gender AudienceGender @default(ALL)

  city     String?
  district String?

  educationLevel String?
  occupation     String?

  sampleBase SurveyAudienceType @default(GENERAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sampleBase])
  @@index([city])
  @@index([district])
}

model SurveySampleBudget {
  id String @id @default(uuid())

  surveyId String @unique
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  requiredResponses Int

  totalBudget Decimal @db.Decimal(12, 2)

  platformCommissionPercentage Decimal @db.Decimal(5, 2)
  platformCommissionAmount     Decimal @db.Decimal(12, 2)

  participantRewardBudget Decimal @db.Decimal(12, 2)
  rewardPerParticipant    Decimal @db.Decimal(12, 2)

  rewardDistribution RewardDistributionType @default(EQUAL_PER_PARTICIPANT)

  currency SurveyBudgetCurrency @default(LKR)

  budgetNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SurveyResponse {
  id String @id @default(uuid())

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  participantId String?
  participant   User?   @relation(fields: [participantId], references: [id], onDelete: SetNull)

  status SurveyResponseStatus @default(STARTED)

  rewardAmount Decimal?     @db.Decimal(12, 2)
  rewardStatus RewardStatus @default(PENDING)

  answers SurveyResponseAnswer[]

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([surveyId, participantId])
  @@index([surveyId])
  @@index([participantId])
  @@index([status])
}

model SurveyResponseAnswer {
  id String @id @default(uuid())

  surveyResponseId String
  surveyResponse   SurveyResponse @relation(fields: [surveyResponseId], references: [id], onDelete: Cascade)

  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  questionType SurveyQuestionType

  answerText        String?
  selectedOptionId  String?
  selectedOptionIds String[] @default([])
  ratingValue       Int?
  booleanValue      Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([surveyResponseId, questionId])
  @@index([surveyResponseId])
  @@index([questionId])
  @@index([questionType])
  @@index([selectedOptionId])
}

model ParticipantWallet {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance        Decimal @default(0) @db.Decimal(12, 2)
  pendingRewards Decimal @default(0) @db.Decimal(12, 2)
  totalEarned    Decimal @default(0) @db.Decimal(12, 2)
  totalWithdrawn Decimal @default(0) @db.Decimal(12, 2)

  currency SurveyBudgetCurrency @default(LKR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  surveyResponseId String?

  type   WalletTransactionType
  status WalletTransactionStatus @default(PENDING)

  amount   Decimal              @db.Decimal(12, 2)
  currency SurveyBudgetCurrency @default(LKR)

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([status])
}
