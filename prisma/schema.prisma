generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PARTICIPANT
  CREATOR
  BOTH
}

enum SurveyStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum SurveyAudienceType {
  GENERAL
  CUSTOMERS
  VISITORS
  EMPLOYEES
  VERIFIED_USERS_ONLY
}

enum NotificationType {
  RESPONSE
  SURVEY
  REPORT
  SYSTEM
}

enum SurveyCategory {
  CUSTOMER_FEEDBACK
  MARKET_RESEARCH
  EMPLOYEE_ENGAGEMENT
  EDUCATION
  HEALTHCARE
  PRODUCT_RESEARCH
  EVENT_FEEDBACK
  OTHER
}

enum SurveyCreationStep {
  BASIC_DETAILS
  SELECT_METHOD
  CREATE_QUESTIONS
  TARGET_AUDIENCE
  SAMPLE_BUDGET
  PREVIEW_SUBMIT
  COMPLETED
}

enum SurveyCreationMethod {
  AI_ASSISTED
  MANUAL
}

enum SurveyQuestionType {
  MULTIPLE_CHOICE
  SINGLE_SELECT
  RATING_SCALE
  SHORT_ANSWER
  LONG_ANSWER
  YES_NO
}

enum SurveyQuestionSource {
  AI_GENERATED
  MANUAL
}

enum AiAnswerStyle {
  MULTIPLE_CHOICE
  SINGLE_SELECT
  RATING_SCALE
  MIXED
}

enum AiToneStyle {
  PROFESSIONAL_FRIENDLY
  SIMPLE_CLEAR
  ACADEMIC
  CASUAL
}

model User {
  id       String   @id @default(uuid())
  username String   @default("existing_user")
  email    String   @unique
  password String
  role     UserRole

  nicHash      String? @unique
  nicImagePath String?
  selfiePath   String?

  profileImagePath String?
  isEmailVerified  Boolean @default(false)

  refreshTokens RefreshToken[]

  passwordResetTokens PasswordResetToken[]

  createdSurveys Survey[]

  surveyResponses SurveyResponse[]

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Survey {
  id          String @id @default(uuid())
  title       String
  description String

  category SurveyCategory
  audience SurveyAudienceType @default(GENERAL)

  status SurveyStatus @default(DRAFT)

  estimatedCompletionDays Int

  currentStep SurveyCreationStep @default(BASIC_DETAILS)

  creationMethod SurveyCreationMethod?

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  questions SurveyQuestion[]
  responses SurveyResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([status])
  @@index([category])
}

model SurveyResponse {
  id String @id @default(uuid())

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  participantId String?
  participant   User?   @relation(fields: [participantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([surveyId])
  @@index([participantId])
}

model Notification {
  id      String           @id @default(uuid())
  title   String
  message String?
  type    NotificationType @default(SYSTEM)
  isRead  Boolean          @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model SurveyQuestion {
  id String @id @default(uuid())

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  questionText String
  type         SurveyQuestionType
  source       SurveyQuestionSource @default(MANUAL)

  order Int

  isRequired Boolean @default(true)

  options SurveyQuestionOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([surveyId])
  @@index([type])
}

model SurveyQuestionOption {
  id String @id @default(uuid())

  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  optionText String
  order      Int

  createdAt DateTime @default(now())

  @@index([questionId])
}
